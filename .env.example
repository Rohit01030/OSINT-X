# App
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://osintx:osintx@postgres:5432/osintx
POSTGRES_USER=osintx
POSTGRES_PASSWORD=osintx
POSTGRES_DB=osintx

# Auth (used from Step 6 onward)
SECRET_KEY=replace-this-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis
REDIS_URL=redis://redis:6379/0

# Frontend (used from Step 2 onward)
